# Without configuration, npm run dev shows setup instructions. npm run demo is
# an explicit local-only simulation and does not need this file.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
TIDECLOAK_CONFIG_PATH=./data/tidecloak.json
CREATORROOM_DATA_PATH=./data/creatorroom-tide.json

# Export the PUBLIC client adapter from TideCloak to the ignored path above.
# Never paste a client secret into browser configuration. See docs/TIDECLOAK.md.
